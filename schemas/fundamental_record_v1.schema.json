{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scout-finance.local/schemas/fundamental_record_v1.schema.json",
  "title": "Scout Finance FundamentalRecord v1",
  "description": "Canonical, long-format (one metric-observation per row) fundamentals record for phase 5 (block C). Every observation is traceable end to end: provider, endpoint, requested identifier, acquisition date, company, asset, fiscal period, period close date, publication date (if known), currency, original unit/scale, original value, applied transformation, normalizer version, and validation state.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "record_id", "asset_id", "pilot_id", "ticker", "provider_symbol",
    "company_name", "exchange", "country", "provider", "source_url_or_endpoint",
    "retrieved_at", "normalizer_version",
    "statement_type", "period_type", "fiscal_year", "period_start", "period_end",
    "consolidation_scope", "accounting_standard",
    "metric", "raw_metric", "value", "raw_value", "currency", "raw_currency",
    "unit", "scale", "sign_convention", "value_status",
    "source_status", "normalization_status", "validation_status", "missing_reason", "quality_flags"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "record_id": {"type": "string", "description": "Deterministic id, e.g. sha256 of asset_id+provider+statement_type+period_type+fiscal_year+fiscal_quarter+metric+consolidation_scope."},

    "asset_id": {"type": "string", "description": "This project's internal pilot_id, e.g. P143."},
    "company_id": {"type": ["string", "null"], "description": "Reserved for a future cross-provider company identifier (LEI/ISIN); null while none is confirmed -- never fabricated."},
    "pilot_id": {"type": "string"},
    "ticker": {"type": "string"},
    "provider_symbol": {"type": "string"},
    "provider_record_id": {"type": ["string", "null"], "description": "The provider's own disclosure/document id if it exposes one (e.g. J-Quants DiscNo), else null."},
    "company_name": {"type": "string"},
    "exchange": {"type": "string", "enum": ["JPX", "TWSE"]},
    "mic": {"type": ["string", "null"]},
    "country": {"type": "string", "enum": ["JP", "TW"]},
    "isin": {"type": ["string", "null"]},

    "provider": {"type": "string", "enum": ["jquants_fins_summary", "twse_mops_opendata"]},
    "source_url_or_endpoint": {"type": "string", "description": "Endpoint path only -- never a full URL carrying a credential."},
    "retrieved_at": {"type": "string", "format": "date-time"},
    "normalizer_version": {"type": "string"},

    "statement_type": {"type": "string", "enum": ["income_statement", "balance_sheet", "cash_flow", "derived_reported_by_provider"]},
    "period_type": {"type": "string", "enum": ["annual", "quarterly", "semiannual", "ttm", "instant"]},
    "fiscal_year": {"type": "string"},
    "fiscal_quarter": {"type": ["integer", "null"], "minimum": 1, "maximum": 4},
    "period_start": {"type": ["string", "null"], "format": "date"},
    "period_end": {"type": "string", "format": "date"},
    "filing_date": {"type": ["string", "null"], "format": "date"},
    "publication_date": {"type": ["string", "null"], "format": "date"},
    "restatement_status": {"type": "string", "enum": ["original", "restated", "unknown"]},
    "consolidation_scope": {"type": "string", "enum": ["consolidated", "non_consolidated", "unknown"]},
    "accounting_standard": {"type": "string", "enum": ["JGAAP", "IFRS", "USGAAP", "ROC_GAAP", "unknown"]},

    "metric": {"type": "string", "description": "Canonical metric id from config/fundamental_metrics_v1.json."},
    "raw_metric": {"type": "string", "description": "The provider's own field name, verbatim (e.g. 'OP', '營業利益')."},
    "value": {"type": ["number", "null"], "description": "Value after normalization to the project's standard unit for this metric. Null only when value_status is not 'ok'."},
    "raw_value": {"type": ["number", "string", "null"], "description": "The provider's original value, unmodified."},
    "currency": {"type": ["string", "null"], "enum": ["JPY", "TWD", null]},
    "raw_currency": {"type": ["string", "null"]},
    "unit": {"type": "string", "enum": ["currency", "shares", "currency_per_share", "percent", "ratio", "days", "count"]},
    "scale": {"type": "string", "enum": ["units", "thousands", "millions", "unknown"]},
    "sign_convention": {"type": "string", "enum": ["natural", "expense_positive", "expense_negative"]},
    "value_status": {"type": "string", "enum": ["ok", "estimated", "provider_reported_only", "calculated"], "description": "'estimated' is never used in phase 5 per rule 3.1 (no synthetic values) -- reserved for a future phase; kept in the enum so downstream code can fail closed if it ever appears."},

    "source_status": {"type": "string", "enum": ["received", "http_error", "auth_error", "rate_limited", "timeout", "empty_response", "identity_mismatch", "schema_mismatch", "provider_error", "license_block"]},
    "normalization_status": {"type": "string", "enum": ["normalized", "normalization_error", "not_attempted"]},
    "validation_status": {"type": "string", "enum": ["pending", "passed", "flagged", "rejected"]},
    "missing_reason": {"type": ["string", "null"], "description": "One of config/fundamental_missing_reasons_v1.json's codes, required whenever value is null."},
    "quality_flags": {"type": "array", "items": {"type": "string"}},
    "transformation_notes": {"type": ["string", "null"]}
  }
}
