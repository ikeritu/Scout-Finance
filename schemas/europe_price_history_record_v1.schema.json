{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scout-finance.local/schemas/europe_price_history_record_v1.schema.json",
  "title": "Europe price history record v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "date",
    "open",
    "high",
    "low",
    "close",
    "adjusted_close",
    "volume",
    "provider",
    "provider_symbol",
    "home_exchange",
    "home_mic",
    "home_currency"
  ],
  "properties": {
    "date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "open": {"type": ["number", "string"]},
    "high": {"type": ["number", "string"]},
    "low": {"type": ["number", "string"]},
    "close": {"type": ["number", "string"]},
    "adjusted_close": {"type": ["number", "string"]},
    "volume": {"type": ["number", "string"]},
    "provider": {"type": "string", "enum": ["stooq", "twelvedata", "eodhd", "yahoo_chart"]},
    "provider_symbol": {"type": "string"},
    "home_exchange": {"type": "string"},
    "home_mic": {"type": "string"},
    "home_currency": {"type": "string"}
  }
}
