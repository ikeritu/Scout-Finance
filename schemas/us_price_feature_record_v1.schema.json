{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "asset_id": {"type": "string", "pattern": "^U[0-9]{5}$"},
    "ticker": {"type": "string"},
    "company_name": {"type": "string"},
    "exchange": {"type": "string"},
    "price_rows": {"type": "integer"},
    "date_start": {"type": "string"},
    "date_end": {"type": "string"},
    "trading_days_1y": {"type": "integer"},
    "adjusted_prices_available": {"type": "boolean"},
    "price_feature_quality_status": {
      "enum": [
        "PRICE_FEATURES_READY",
        "PRICE_FEATURES_PARTIAL",
        "INSUFFICIENT_PRICE_EVIDENCE",
        "PRICE_FEATURES_BLOCKED_NO_LOCAL_US_PRICE_HISTORY"
      ],
      "type": "string"
    },
    "features_calculated": {"type": "integer"},
    "features_missing": {"type": "string"},
    "quality_flags": {"type": "string"},
    "return_1m": {"type": ["number", "null"]},
    "return_3m": {"type": ["number", "null"]},
    "return_6m": {"type": ["number", "null"]},
    "return_12m": {"type": ["number", "null"]},
    "price_vs_sma_50": {"type": ["number", "null"]},
    "price_vs_sma_200": {"type": ["number", "null"]},
    "sma_50_vs_sma_200": {"type": ["number", "null"]},
    "volatility_3m": {"type": ["number", "null"]},
    "volatility_6m": {"type": ["number", "null"]},
    "max_drawdown_6m": {"type": ["number", "null"]},
    "max_drawdown_12m": {"type": ["number", "null"]},
    "downside_volatility_6m": {"type": ["number", "null"]},
    "avg_volume_1m": {"type": ["number", "null"]},
    "avg_volume_3m": {"type": ["number", "null"]},
    "momentum_consistency_flag": {"type": "boolean"},
    "trend_positive_flag": {"type": "boolean"},
    "recent_high_breakout_flag": {"type": "boolean"},
    "near_52w_high_flag": {"type": "boolean"},
    "recovery_from_drawdown_flag": {"type": "boolean"},
    "price_acceleration_flag": {"type": "boolean"},
    "liquidity_available_flag": {"type": "boolean"},
    "phase": {"const": "v2.38H", "type": "string"}
  },
  "required": [
    "asset_id",
    "ticker",
    "company_name",
    "exchange",
    "price_rows",
    "date_start",
    "date_end",
    "trading_days_1y",
    "adjusted_prices_available",
    "price_feature_quality_status",
    "features_calculated",
    "features_missing",
    "quality_flags",
    "phase"
  ],
  "title": "US Price Feature Record v1",
  "type": "object"
}
