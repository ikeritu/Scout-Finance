{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scout-finance.local/schemas/europe_fundamentals_execution_readiness_gate_record_v1.schema.json",
  "title": "Europe fundamentals execution readiness gate record v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "route",
    "route_phase",
    "assets_in_route",
    "execution_method",
    "automation_script_status",
    "credential_env_var",
    "credential_present",
    "prerequisite_description",
    "prerequisite_complete_assets",
    "prerequisite_required_assets",
    "prerequisite_status",
    "blockers",
    "readiness_status",
    "next_required_action",
    "real_fundamentals_downloaded",
    "network_used_in_this_gate",
    "phase9c_authorized",
    "phase",
    "contract_version",
    "created_at_utc",
    "notes"
  ],
  "properties": {
    "route": {"enum": ["provider_pilot", "official_filings_review", "manual_review"]},
    "route_phase": {"enum": ["v2.38R", "v2.38S", "v2.38T"]},
    "assets_in_route": {"type": "string", "pattern": "^[0-9]+$"},
    "execution_method": {"enum": ["automated_provider_api", "official_registry_access", "human_manual_review"]},
    "automation_script_status": {"enum": ["NOT_IMPLEMENTED", "IMPLEMENTED", "NOT_APPLICABLE_HUMAN_PROCESS"]},
    "credential_env_var": {"type": "string"},
    "credential_present": {"enum": ["true", "false", "not_applicable"]},
    "prerequisite_description": {"type": "string"},
    "prerequisite_complete_assets": {"type": "string", "pattern": "^[0-9]+$"},
    "prerequisite_required_assets": {"type": "string", "pattern": "^[0-9]+$"},
    "prerequisite_status": {"enum": ["COMPLETE", "INCOMPLETE"]},
    "blockers": {"type": "string"},
    "readiness_status": {"enum": ["READY", "NOT_READY"]},
    "next_required_action": {"type": "string"},
    "real_fundamentals_downloaded": {"const": "false"},
    "network_used_in_this_gate": {"const": "false"},
    "phase9c_authorized": {"const": "false"},
    "phase": {"const": "v2.38U-europe-fundamentals-execution-readiness-gate"},
    "contract_version": {"const": "europe_fundamentals_execution_readiness_gate_contract_v1"},
    "created_at_utc": {"type": "string"},
    "notes": {"type": "string"}
  }
}
