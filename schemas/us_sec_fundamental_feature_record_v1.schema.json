{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "asset_id": {"type": "string", "pattern": "^U[0-9]{5}$"},
    "ticker": {"type": "string"},
    "company_name": {"type": "string"},
    "exchange": {"type": "string"},
    "cik": {"type": "string", "pattern": "^[0-9]{10}$"},
    "feature_asof_fy": {"type": "integer"},
    "latest_filed": {"type": "string"},
    "latest_period_end": {"type": "string"},
    "evidence_years": {"type": "integer"},
    "evidence_quarters": {"type": "integer"},
    "feature_quality_status": {
      "enum": ["FEATURES_READY", "FEATURES_PARTIAL", "INSUFFICIENT_FEATURE_EVIDENCE"],
      "type": "string"
    },
    "features_calculated": {"type": "integer"},
    "features_missing": {"type": "string"},
    "quality_flags": {"type": "string"},
    "revenue_yoy_growth": {"type": ["number", "null"]},
    "net_income_yoy_growth": {"type": ["number", "null"]},
    "operating_cash_flow_yoy_growth": {"type": ["number", "null"]},
    "assets_yoy_growth": {"type": ["number", "null"]},
    "equity_yoy_growth": {"type": ["number", "null"]},
    "net_margin": {"type": ["number", "null"]},
    "return_on_assets": {"type": ["number", "null"]},
    "return_on_equity": {"type": ["number", "null"]},
    "operating_cash_flow_margin": {"type": ["number", "null"]},
    "liabilities_to_assets": {"type": ["number", "null"]},
    "equity_to_assets": {"type": ["number", "null"]},
    "free_cash_flow": {"type": ["number", "null"]},
    "free_cash_flow_margin": {"type": ["number", "null"]},
    "capex_to_revenue": {"type": ["number", "null"]},
    "cash_conversion_ratio": {"type": ["number", "null"]},
    "growth_acceleration_flag": {"type": "boolean"},
    "margin_expansion_flag": {"type": "boolean"},
    "positive_fcf_flag": {"type": "boolean"},
    "balance_strength_flag": {"type": "boolean"},
    "fundamental_momentum_flag": {"type": "boolean"},
    "phase": {"const": "v2.38G", "type": "string"}
  },
  "required": [
    "asset_id",
    "ticker",
    "company_name",
    "exchange",
    "cik",
    "feature_asof_fy",
    "latest_filed",
    "latest_period_end",
    "evidence_years",
    "evidence_quarters",
    "feature_quality_status",
    "features_calculated",
    "features_missing",
    "quality_flags",
    "phase"
  ],
  "title": "US SEC Fundamental Feature Record v1",
  "type": "object"
}
