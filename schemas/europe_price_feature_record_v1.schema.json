{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scout-finance.local/schemas/europe_price_feature_record_v1.schema.json",
  "title": "Europe price feature record v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "asset_id",
    "ticker",
    "company_name",
    "home_exchange",
    "home_mic",
    "home_country",
    "home_currency",
    "provider",
    "provider_symbol",
    "price_first_date",
    "price_last_date",
    "price_rows",
    "return_1m",
    "return_3m",
    "return_6m",
    "return_12m",
    "volatility_3m",
    "volatility_6m",
    "downside_volatility_6m",
    "max_drawdown_6m",
    "max_drawdown_12m",
    "price_vs_sma_50",
    "price_vs_sma_200",
    "sma_50_vs_sma_200",
    "avg_volume_1m",
    "avg_volume_3m",
    "liquidity_available_flag",
    "trend_positive_flag",
    "momentum_consistency_flag",
    "near_52w_high_flag",
    "recent_high_breakout_flag",
    "recovery_from_drawdown_flag",
    "price_acceleration_flag",
    "price_quality_status",
    "phase",
    "scoring_calculated",
    "ranking_calculated",
    "recommendations_generated",
    "phase9c_authorized"
  ],
  "properties": {
    "asset_id": {"type": "string", "pattern": "^U[0-9]+$"},
    "ticker": {"type": "string"},
    "company_name": {"type": "string"},
    "home_exchange": {"type": "string"},
    "home_mic": {"type": "string"},
    "home_country": {"type": "string"},
    "home_currency": {"type": "string"},
    "provider": {"type": "string"},
    "provider_symbol": {"type": "string"},
    "price_first_date": {"type": "string"},
    "price_last_date": {"type": "string"},
    "price_rows": {"type": "string"},
    "return_1m": {"type": "string"},
    "return_3m": {"type": "string"},
    "return_6m": {"type": "string"},
    "return_12m": {"type": "string"},
    "volatility_3m": {"type": "string"},
    "volatility_6m": {"type": "string"},
    "downside_volatility_6m": {"type": "string"},
    "max_drawdown_6m": {"type": "string"},
    "max_drawdown_12m": {"type": "string"},
    "price_vs_sma_50": {"type": "string"},
    "price_vs_sma_200": {"type": "string"},
    "sma_50_vs_sma_200": {"type": "string"},
    "avg_volume_1m": {"type": "string"},
    "avg_volume_3m": {"type": "string"},
    "liquidity_available_flag": {"type": "string", "enum": ["true", "false"]},
    "trend_positive_flag": {"type": "string", "enum": ["true", "false"]},
    "momentum_consistency_flag": {"type": "string", "enum": ["true", "false"]},
    "near_52w_high_flag": {"type": "string", "enum": ["true", "false"]},
    "recent_high_breakout_flag": {"type": "string", "enum": ["true", "false"]},
    "recovery_from_drawdown_flag": {"type": "string", "enum": ["true", "false"]},
    "price_acceleration_flag": {"type": "string", "enum": ["true", "false"]},
    "price_quality_status": {
      "type": "string",
      "enum": [
        "EUROPE_PRICE_FEATURES_READY",
        "EUROPE_PRICE_FEATURES_PARTIAL",
        "EUROPE_PRICE_FEATURES_INSUFFICIENT",
        "EUROPE_PRICE_FEATURES_BLOCKED_NO_LOCAL_HISTORY",
        "EUROPE_PRICE_FEATURES_REJECTED_BAD_SCHEMA",
        "EUROPE_PRICE_FEATURES_REJECTED_CBOE_SOURCE"
      ]
    },
    "phase": {"const": "v2.38P-europe-price-features"},
    "scoring_calculated": {"const": "false"},
    "ranking_calculated": {"const": "false"},
    "recommendations_generated": {"const": "false"},
    "phase9c_authorized": {"const": "false"}
  }
}
