{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scout-finance.local/schemas/europe_official_filings_review_record_v1.schema.json",
  "title": "Europe official filings review record v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "asset_id",
    "company_name",
    "ticker",
    "exchange",
    "mic",
    "country",
    "currency",
    "isin",
    "source_phase",
    "source_row_hash",
    "route_from_38q",
    "official_review_status",
    "official_registry_candidate",
    "official_registry_name",
    "filing_route_type",
    "filing_identifier_required",
    "filing_identifier_present",
    "filing_identifier_value",
    "identifier_confidence",
    "jurisdiction_code",
    "jurisdiction_review_priority",
    "official_filings_fetch_status",
    "official_filings_data_status",
    "real_filings_downloaded",
    "real_fundamentals_present",
    "normalized_fundamentals_present",
    "requires_future_official_execution",
    "requires_identifier_resolution",
    "no_network_fetch",
    "no_scraping",
    "no_api_call",
    "no_scoring",
    "no_ranking",
    "no_recommendation",
    "no_phase9c",
    "created_at_utc",
    "phase",
    "contract_version",
    "notes"
  ],
  "properties": {
    "asset_id": {"type": "string", "pattern": "^U[0-9]+$"},
    "company_name": {"type": "string"},
    "ticker": {"type": "string"},
    "exchange": {"type": "string"},
    "mic": {"type": "string"},
    "country": {"type": "string"},
    "currency": {"type": "string"},
    "isin": {"type": "string"},
    "source_phase": {"const": "v2.38Q-europe-fundamentals-route-foundation"},
    "source_row_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "route_from_38q": {"const": "FUNDAMENTALS_ROUTE_READY_FOR_OFFICIAL_FILINGS_REVIEW"},
    "official_review_status": {"type": "string"},
    "official_registry_candidate": {"type": "string"},
    "official_registry_name": {"type": "string"},
    "filing_route_type": {"const": "official_registry_review"},
    "filing_identifier_required": {"type": "string"},
    "filing_identifier_present": {"const": "false"},
    "filing_identifier_value": {"const": ""},
    "identifier_confidence": {"const": "NONE"},
    "jurisdiction_code": {"type": "string"},
    "jurisdiction_review_priority": {"type": "string", "pattern": "^[0-9]+$"},
    "official_filings_fetch_status": {"const": "NOT_REQUESTED_OFFLINE_PHASE"},
    "official_filings_data_status": {"const": "NO_REAL_FILINGS_OFFICIAL_EXECUTION_REQUIRED"},
    "real_filings_downloaded": {"const": "false"},
    "real_fundamentals_present": {"const": "false"},
    "normalized_fundamentals_present": {"const": "false"},
    "requires_future_official_execution": {"const": "true"},
    "requires_identifier_resolution": {"const": "true"},
    "no_network_fetch": {"const": "true"},
    "no_scraping": {"const": "true"},
    "no_api_call": {"const": "true"},
    "no_scoring": {"const": "true"},
    "no_ranking": {"const": "true"},
    "no_recommendation": {"const": "true"},
    "no_phase9c": {"const": "true"},
    "created_at_utc": {"type": "string"},
    "phase": {"const": "v2.38S-europe-official-filings-review"},
    "contract_version": {"const": "europe_official_filings_review_contract_v1"},
    "notes": {"type": "string"}
  }
}
