{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scout-finance.local/schemas/europe_manual_review_pack_record_v1.schema.json",
  "title": "Europe manual review pack record v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "asset_id",
    "company_name_source_value",
    "identity_verified",
    "ticker",
    "home_exchange",
    "home_mic",
    "home_country",
    "home_currency",
    "source_phase",
    "source_row_hash",
    "route_from_38q",
    "manual_review_status",
    "identity_review_required",
    "registry_review_required",
    "provider_review_required",
    "candidate_registry_note",
    "required_human_actions",
    "real_filings_downloaded",
    "real_fundamentals_present",
    "normalized_fundamentals_present",
    "no_network_fetch",
    "no_scraping",
    "no_api_call",
    "no_scoring",
    "no_ranking",
    "no_recommendation",
    "no_phase9c",
    "created_at_utc",
    "phase",
    "contract_version",
    "notes"
  ],
  "properties": {
    "asset_id": {"type": "string", "pattern": "^U[0-9]+$"},
    "company_name_source_value": {"type": "string"},
    "identity_verified": {"const": "false"},
    "ticker": {"type": "string"},
    "home_exchange": {"type": "string"},
    "home_mic": {"type": "string"},
    "home_country": {"type": "string"},
    "home_currency": {"type": "string"},
    "source_phase": {"const": "v2.38Q-europe-fundamentals-route-foundation"},
    "source_row_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "route_from_38q": {"const": "FUNDAMENTALS_ROUTE_MANUAL_REVIEW_REQUIRED"},
    "manual_review_status": {"type": "string"},
    "identity_review_required": {"const": "true"},
    "registry_review_required": {"const": "true"},
    "provider_review_required": {"const": "true"},
    "candidate_registry_note": {"type": "string"},
    "required_human_actions": {"type": "string"},
    "real_filings_downloaded": {"const": "false"},
    "real_fundamentals_present": {"const": "false"},
    "normalized_fundamentals_present": {"const": "false"},
    "no_network_fetch": {"const": "true"},
    "no_scraping": {"const": "true"},
    "no_api_call": {"const": "true"},
    "no_scoring": {"const": "true"},
    "no_ranking": {"const": "true"},
    "no_recommendation": {"const": "true"},
    "no_phase9c": {"const": "true"},
    "created_at_utc": {"type": "string"},
    "phase": {"const": "v2.38T-europe-manual-review-pack"},
    "contract_version": {"const": "europe_manual_review_pack_contract_v1"},
    "notes": {"type": "string"}
  }
}
